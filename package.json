{
	"name": "postcard-styleguide",
	"version": "0.2.0",
	"description": "Postcard: a warm, playful, framework-agnostic style guide (CSS tokens, components and a few vanilla helpers) from the GT Retrospective tour site.",
	"type": "module",
	"private": true,
	"files": [
		"postcard.css",
		"css",
		"fonts",
		"icons",
		"js",
		"dist",
		"assets"
	],
	"exports": {
		".": "./dist/postcard.css",
		"./postcard.css": "./postcard.css",
		"./tokens.css": "./css/tokens.css",
		"./tokens.json": "./dist/tokens.json",
		"./css/*": "./css/*",
		"./js": "./js/postcard.js",
		"./icons/*": "./icons/*"
	},
	"scripts": {
		"dev": "node scripts/serve.mjs",
		"build": "node scripts/build.mjs",
		"check": "node scripts/check.mjs",
		"prepare": "node scripts/build.mjs",
		"test": "playwright test --grep-invert @visual",
		"test:visual": "playwright test --grep @visual",
		"test:visual:update": "playwright test --grep @visual --update-snapshots"
	},
	"engines": {
		"node": ">=20.11"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@playwright/test": "^1.63.0"
	}
}
